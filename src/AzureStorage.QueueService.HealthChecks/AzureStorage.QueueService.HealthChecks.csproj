<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>$(MSBuildProjectName)</AssemblyName>
		<RootNamespace>$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IsAotCompatible>true</IsAotCompatible>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Company>Unifinity Software Corporation</Company>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Description>ASP.NET Core health checks for AzureStorage.QueueService: one that reports whether the hosted queue processors are receiving, paused or stuck (free, no storage calls), and one that checks a queue can be reached and, optionally, that its poison queue is empty.</Description>
		<Copyright>Unifinity Software Corporation</Copyright>
		<PackageTags>Azure, Azure Storage, Azure Storage Queue, Storage Queue, Queue Service, Health Checks, HealthChecks, Jason Shave, Unifinity Software Corporation</PackageTags>
		<PackageProjectUrl>https://github.com/jasonshave/AzureStorage.QueueService</PackageProjectUrl>
		<PackageIcon>logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/jasonshave/AzureStorage.QueueService</RepositoryUrl>
		<Authors>Unifinity Software Corporation</Authors>
		<AssemblyVersion></AssemblyVersion>
		<Version>$(VersionPrefix)</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.13" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AzureStorage.QueueService\AzureStorage.QueueService.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\images\logo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
