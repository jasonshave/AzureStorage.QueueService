<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>$(MSBuildProjectName)</AssemblyName>
		<RootNamespace>$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IsAotCompatible>true</IsAotCompatible>
		<Company>Unifinity Software Corporation</Company>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Description>Sends Azure Storage queue messages over the 64 KiB limit by keeping their bodies in Azure Blob storage (the claim-check pattern), for AzureStorage.QueueService. One line per client: UseBlobStorageForLargeMessages().</Description>
		<Copyright>Unifinity Software Corporation</Copyright>
		<PackageTags>Azure, Azure Storage, Azure Storage Queue, Storage Queue, Queue Service, Blob Storage, Claim Check, Large Messages, Jason Shave, Unifinity Software Corporation</PackageTags>
		<PackageProjectUrl>https://github.com/jasonshave/AzureStorage.QueueService</PackageProjectUrl>
		<PackageIcon>logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/jasonshave/AzureStorage.QueueService</RepositoryUrl>
		<Authors>Unifinity Software Corporation</Authors>
		<AssemblyVersion></AssemblyVersion>
		<Version>$(VersionPrefix)</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AzureStorage.QueueService\AzureStorage.QueueService.csproj" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>$(AssemblyName).Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\images\logo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
